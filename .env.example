# Copy to .env, fill locally, then source it before starting the server.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/music/spotify/callback
# Optional; the selected Apple-search architecture does not need this secret.
SPOTIFY_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_example.p8
APPLE_STOREFRONT=es
COOKIE_SECURE=false
# Optional invitation origin override, e.g. http://192.168.1.80:8000 or your HTTPS game URL.
APP_PUBLIC_URL=
# Testing only: allow two-player games and repeated Spotify accounts with separate nicknames.
PLAYTEST_MODE=false
