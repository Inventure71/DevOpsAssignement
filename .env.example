# Optional real-game settings: copy to .env and fill locally.
# tools/run_real_game.sh loads this file; tools/run_demo.sh ignores it.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=https://your-game-host.example/api/music/spotify/callback
# Register and save this exact callback in your Spotify application.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_example.p8
APPLE_STOREFRONT=es
COOKIE_SECURE=true
# Shared HTTPS origin; keep the tunnel forwarding to this application's port.
APP_PUBLIC_URL=https://your-game-host.example
# Testing only: allow two-player games and repeated Spotify accounts with separate nicknames.
PLAYTEST_MODE=false
